# MongoDB Atlas database used by the CMS and public website APIs.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tabiat_gran_cms?retryWrites=true&w=majority

# Generate a random value of at least 32 characters. Used to sign CMS sessions.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudinary credentials used by Media Library and profile image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed/setup options. These are not required for normal runtime after setup.
MIGRATE_LEGACY_MEDIA=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# Optional only if you intentionally allow a separate external public origin.
# For the normal single-domain deployment, leave this unset.
# PUBLIC_WEB_ORIGIN=https://example.com
